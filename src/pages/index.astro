---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Skills from '../components/Skills.astro';
import Comparison from '../components/Comparison.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Hantsaniala - Python & Go Developer"
  description="Need a backend dev who ships? Freelance Go & Python developer with 10+ years in APIs, microservices & cloud. Available now."
  ogDescription="10+ years building backend systems in Go & Python. Freelance developer specialising in APIs, microservices, and cloud infrastructure. Let's talk."
  twitterDescription="Freelance Go & Python developer. 10+ years shipping backend systems, APIs & cloud infrastructure. Available for hire."
>
  <!-- 1. Hero — H1 + AEO + CTA -->
  <Hero />

  <div class="px-6 py-12 lg:px-12 lg:py-16 space-y-4">
    <!-- Proof first: client work and open source -->
    <Projects />

    <!-- Why hire a freelancer: problem, solution, how it works, comparison -->
    <About />
    <Comparison />

    <!-- Skills, with the daily tool stack folded in -->
    <Skills />

    <!-- Experience, with education folded in -->
    <Experience />

    <Faq />

    <!-- 10. Trust Signals + 11. Final CTA -->
    <Footer />
  </div>
</BaseLayout>
