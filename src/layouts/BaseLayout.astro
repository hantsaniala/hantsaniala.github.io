      let currentLocale = 'fr';

      function detectLocale() {
        const saved = localStorage.getItem('locale');
        if (saved && (saved === 'en' || saved === 'fr')) return saved;
        const browserLang = navigator.language || navigator.userLanguage;
        if (browserLang && browserLang.startsWith('en')) return 'en';
        return 'fr';
      }

      function setLocale(locale) {
        if (!translations[locale]) return;
        currentLocale = locale;
        localStorage.setItem('locale', locale);
        document.documentElement.lang = locale;
        applyTranslations();
        updateSwitcherButtons();
      }

      function t(key) {
        return translations[currentLocale]?.[key] || key;
      }

      function applyTranslations() {
        document.querySelectorAll('[data-i18n]').forEach(el => {
          const key = el.getAttribute('data-i18n');
          if (key) {
            const text = t(key);
            if (text) el.textContent = text;
          }
        });
        document.querySelectorAll('[data-i18n-html]').forEach(el => {
          const key = el.getAttribute('data-i18n-html');
          if (key) {
            const text = t(key);
            if (text) el.innerHTML = text;
          }
        });
      }

      function updateSwitcherButtons() {
        const label = currentLocale === 'en' ? 'FR' : 'EN';
        document.querySelectorAll('.lang-label').forEach(el => {
          el.textContent = label;
        });
        const targetLang = currentLocale === 'en' ? 'Français' : 'English';
        document.querySelectorAll('#lang-switcher, #lang-switcher-mobile').forEach(btn => {
          btn.setAttribute('aria-label', `Switch to ${targetLang}`);
        });
      }

      document.addEventListener('DOMContentLoaded', () => {
        currentLocale = detectLocale();
        document.documentElement.lang = currentLocale;
        applyTranslations();
        updateSwitcherButtons();
        document.querySelectorAll('#lang-switcher, #lang-switcher-mobile').forEach(btn => {
          btn.addEventListener('click', () => {
            setLocale(currentLocale === 'en' ? 'fr' : 'en');
          });
        });
      });
    </script>

    <script is:inline>
      // Cursor follower — abstract blobs (pauses when tab hidden)
      (function() {
        const canvas = document.getElementById('cursor-canvas');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        let W = 0, H = 0;
        let mouseX = 0, mouseY = 0;
        let targetX = 0, targetY = 0;
        let running = true;
        let rafId = 0;

        const blobs = [
          { x: 0, y: 0, r: 300, color: 'rgba(255,210,0,0.08)', speed: 0.03 },
          { x: 0, y: 0, r: 200, color: 'rgba(255,210,0,0.05)', speed: 0.06 },
          { x: 0, y: 0, r: 188, color: 'rgba(255,210,0,0.03)', speed: 0.08 },
        ];

        function resize() {
          W = canvas.width = window.innerWidth;
          H = canvas.height = window.innerHeight;
        }
        resize();
        window.addEventListener('resize', resize);

        document.addEventListener('mousemove', (e) => {
          mouseX = e.clientX;
          mouseY = e.clientY;
        });

        function animate() {
          if (!running) return;
          ctx.clearRect(0, 0, W, H);
          targetX += (mouseX - targetX) * 0.05;
          targetY += (mouseY - targetY) * 0.05;

          blobs.forEach((b) => {
            b.x += (targetX - b.x) * b.speed;
            b.y += (targetY - b.y) * b.speed;
            const grad = ctx.createRadialGradient(b.x, b.y, 0, b.x, b.y, b.r);
            grad.addColorStop(0, b.color);
            grad.addColorStop(1, 'transparent');
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, W, H);
          });

          rafId = requestAnimationFrame(animate);
        }

        document.addEventListener('visibilitychange', () => {
          if (document.hidden) {
            running = false;
            cancelAnimationFrame(rafId);
          } else {
            running = true;
            rafId = requestAnimationFrame(animate);
          }
        });

        rafId = requestAnimationFrame(animate);
      })();

      // Back to top
      const btn = document.getElementById('back-to-top');
      const hero = document.getElementById('hero');
      if (btn && hero) {
        window.addEventListener('scroll', () => {
          if (hero.getBoundingClientRect().bottom < 0) {
            btn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
            btn.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
          } else {
            btn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
            btn.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
          }
        }, { passive: true });
        btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      }

      // Scroll reveal with stagger
      const reveals = document.querySelectorAll('.reveal');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.05, rootMargin: '0px 0px -40px 0px' });
      reveals.forEach(el => observer.observe(el));

      // Parallax
      const parallaxEls = document.querySelectorAll('.parallax-bg');
      window.addEventListener('scroll', () => {
        parallaxEls.forEach(el => {
          const rect = el.parentElement?.getBoundingClientRect();
          if (rect && rect.bottom > 0 && rect.top < window.innerHeight) {
            const speed = 0.3;
            const y = (rect.top * speed);
            el.style.transform = `translateY(${y}px)`;
          }
        });
      }, { passive: true });
    </script>
  </body>
</html>
