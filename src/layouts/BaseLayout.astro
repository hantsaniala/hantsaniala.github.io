---
import BaseHead from '../components/BaseHead.astro';
import Sidebar from '../components/Sidebar.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <BaseHead title={title} description={description} />
  <body>
    <!-- Skip to content -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-full focus:text-sm focus:font-semibold" style="background: var(--accent); color: var(--accent-text);">Skip to content</a>

    <!-- Cursor follower canvas -->
    <canvas id="cursor-canvas" class="fixed inset-0 w-full h-full pointer-events-none" style="z-index: 0;"></canvas>

    <Sidebar />

    <main id="main-content" class="min-h-screen relative" style="z-index: 1;">
      <slot />
    </main>

    <!-- Back to top -->
    <button id="back-to-top" class="fixed bottom-8 right-8 z-50 w-12 h-12 rounded-full flex items-center justify-center transition-all duration-300 opacity-0 pointer-events-none translate-y-4" style="background: var(--pill-bg); color: var(--text);" aria-label="Back to top">
      <i class="ph ph-arrow-up text-lg"></i>
    </button>

