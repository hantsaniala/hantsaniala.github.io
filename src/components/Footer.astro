---
import { site } from '../data/site';
const currentYear = new Date().getFullYear();
---

<!-- Final CTA -->
<section class="py-24 lg:py-32 text-center" data-animate>
  <div class="max-w-2xl mx-auto space-y-8">
    <span class="eyebrow mx-auto inline-flex">Get Started</span>
    <h2 class="text-display-lg" style="color: var(--text-primary);">
      Ready to Build<br />Something?
    </h2>
    <p class="text-[0.95rem] leading-relaxed mx-auto max-w-lg" style="color: var(--text-secondary);">
      I'm available for freelance backend development projects. Whether you need a new API,
      a system migration, or DevOps setup — let's talk.
    </p>
    <div class="flex justify-center">
      <a href="mailto:hantsaniala@gmail.com?subject=Freelance%20Project%20Inquiry" class="btn-primary">
        Hire Hantsaniala
        <span class="btn-icon">
          <i class="ph ph-arrow-up-right text-sm"></i>
        </span>
      </a>
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="py-16 px-6 lg:px-16" style="border-top: 1px solid var(--card-border);">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
    <!-- Credentials -->
    <div>
      <h3 class="text-xs font-semibold uppercase tracking-widest mb-5" style="color: var(--text-muted);">Credentials</h3>
      <ul class="space-y-3 text-sm" style="color: var(--text-secondary);">
        <li class="flex items-center gap-3"><i class="ph ph-check text-primary"></i>10+ years software development</li>
        <li class="flex items-center gap-3"><i class="ph ph-check text-primary"></i>CTO-level technical leadership</li>
        <li class="flex items-center gap-3"><i class="ph ph-check text-primary"></i>15+ open source repositories</li>
        <li class="flex items-center gap-3"><i class="ph ph-check text-primary"></i>Remote-first, worldwide</li>
      </ul>
    </div>

    <!-- Quick links -->
    <div>
      <h3 class="text-xs font-semibold uppercase tracking-widest mb-5" style="color: var(--text-muted);">Quick Links</h3>
      <ul class="space-y-3 text-sm" style="color: var(--text-secondary);">
        <li><a href="#skills" class="hover:text-primary transition-colors duration-300">Technical Skills</a></li>
        <li><a href="#experience" class="hover:text-primary transition-colors duration-300">Work Experience</a></li>
        <li><a href="#projects" class="hover:text-primary transition-colors duration-300">Open Source Projects</a></li>
        <li><a href="/blog" class="hover:text-primary transition-colors duration-300">Blog & Articles</a></li>
        <li><a href="/resume.pdf" download class="hover:text-primary transition-colors duration-300">Download Resume</a></li>
      </ul>
    </div>

    <!-- Contact -->
    <div>
      <h3 class="text-xs font-semibold uppercase tracking-widest mb-5" style="color: var(--text-muted);">Contact</h3>
      <ul class="space-y-3 text-sm" style="color: var(--text-secondary);">
        <li class="flex items-center gap-3"><i class="ph ph-envelope text-primary"></i><a href="mailto:hantsaniala@gmail.com" class="hover:text-primary transition-colors">hantsaniala@gmail.com</a></li>
        <li class="flex items-center gap-3"><i class="ph ph-phone text-primary"></i>{site.phone}</li>
        <li class="flex items-center gap-3"><i class="ph ph-map-pin text-primary"></i>Madagascar (Remote)</li>
      </ul>
      <div class="flex items-center gap-2 mt-5">
        {site.socials.map((social) => (
          <a href={social.url} target="_blank" rel="noopener noreferrer"
             class="w-8 h-8 flex items-center justify-center rounded-xl transition-all duration-300 hover:bg-[var(--pill-hover-bg)]"
             style="color: var(--text-muted);" title={social.name} aria-label={social.name}>
            <i class={`ph ph-${social.icon} text-base`}></i>
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4"
       style="border-top: 1px solid var(--card-border);">
    <p class="text-xs" style="color: var(--text-muted);">
      &copy; {currentYear} {site.firstName} {site.lastName}
    </p>
    <p class="text-xs" style="color: var(--text-muted);">
      Built with <span class="text-primary">Astro</span> · {new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}
    </p>
  </div>
</footer>
