---
import { site } from '../data/site';
const currentYear = new Date().getFullYear();
---

<!-- Final CTA -->
<section class="section text-center">
  <div class="max-w-2xl mx-auto space-y-8 reveal">
    <h2 class="type-display" style="color: var(--text);" data-i18n="footer.cta.title">Ready to build something?</h2>
    <p class="type-body mx-auto" data-i18n="footer.cta.desc">I'm available for freelance backend development projects. Whether you need a new API, a system migration, or DevOps setup, let's talk.</p>
    <div class="flex justify-center">
      <a href={site.whatsapp} target="_blank" rel="noopener noreferrer" class="btn btn-primary" data-i18n="footer.cta.discuss">
        Let's discuss
        <i class="ph ph-arrow-up-right"></i>
      </a>
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="section" style="border-top: 1px solid var(--border);">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 mb-12">
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider mb-4" style="color: var(--text-muted);" data-i18n="footer.credentials">Credentials</h3>
        <ul class="space-y-2 text-sm" style="color: var(--text-secondary);">
          <li class="flex items-center gap-2"><i class="ph ph-check" style="color: var(--text-muted);"></i><span data-i18n="footer.cred.1">10+ years software development</span></li>
          <li class="flex items-center gap-2"><i class="ph ph-check" style="color: var(--text-muted);"></i><span data-i18n="footer.cred.2">CTO-level technical leadership</span></li>
          <li class="flex items-center gap-2"><i class="ph ph-check" style="color: var(--text-muted);"></i><span data-i18n="footer.cred.3">15+ open source repositories</span></li>
          <li class="flex items-center gap-2"><i class="ph ph-check" style="color: var(--text-muted);"></i><span data-i18n="footer.cred.4">Remote-first, worldwide</span></li>
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider mb-4" style="color: var(--text-muted);" data-i18n="footer.links">Quick links</h3>
        <ul class="space-y-2 text-sm" style="color: var(--text-secondary);">
          <li><a href="#skills" class="hover:opacity-70 transition-opacity" data-i18n="footer.link.skills">Technical Skills</a></li>
          <li><a href="#experience" class="hover:opacity-70 transition-opacity" data-i18n="footer.link.experience">Work Experience</a></li>
          <li><a href="#projects" class="hover:opacity-70 transition-opacity" data-i18n="footer.link.projects">Open Source Projects</a></li>
          <li><a href="/blog" class="hover:opacity-70 transition-opacity" data-i18n="footer.link.blog">Blog & Articles</a></li>
          <li><a href="/resume.pdf" download class="hover:opacity-70 transition-opacity" data-i18n="footer.link.resume">Download Resume</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider mb-4" style="color: var(--text-muted);" data-i18n="footer.contact">Contact</h3>
        <ul class="space-y-2 text-sm" style="color: var(--text-secondary);">
          <li class="flex items-center gap-2"><i class="ph ph-whatsapp-logo" style="color: var(--text-muted);"></i><a href={site.whatsapp} target="_blank" rel="noopener noreferrer" class="hover:opacity-70 transition-opacity" data-i18n="footer.whatsapp">WhatsApp</a></li>
          <li class="flex items-center gap-2"><i class="ph ph-envelope" style="color: var(--text-muted);"></i><a href="mailto:hantsaniala@gmail.com" class="hover:opacity-70 transition-opacity">hantsaniala@gmail.com</a></li>
          <li class="flex items-center gap-2"><i class="ph ph-phone" style="color: var(--text-muted);"></i>{site.phone}</li>
          <li class="flex items-center gap-2"><i class="ph ph-map-pin" style="color: var(--text-muted);"></i><span data-i18n="footer.location">Madagascar (Remote)</span></li>
        </ul>
        <div class="flex items-center gap-2 mt-4">
          {site.socials.map((social) => (
            <a href={social.url} target="_blank" rel="noopener noreferrer me"
               class="w-8 h-8 flex items-center justify-center rounded-full transition-all duration-200 hover:opacity-70"
               style="background: var(--pill-bg); color: var(--text-secondary);" title={social.name} aria-label={social.name}>
              <i class={`ph ph-${social.icon} text-sm`}></i>
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4" style="border-top: 1px solid var(--border);">
      <p class="text-xs" style="color: var(--text-muted);">&copy; {currentYear} {site.firstName} {site.lastName}</p>
      <div class="flex items-center gap-4 text-xs" style="color: var(--text-muted);">
        <a href="/privacy" class="hover:opacity-70 transition-opacity" data-i18n="footer.privacy">Privacy</a>
        <a href="/terms" class="hover:opacity-70 transition-opacity" data-i18n="footer.terms">Terms</a>
        <span data-i18n-html="footer.built">Built with <span style="color: var(--text);">Astro</span></span>
      </div>
    </div>
  </div>
</footer>
