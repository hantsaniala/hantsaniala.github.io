---
import education from '../data/education.json';
---

<section id="education" class="section">
  <div class="max-w-6xl mx-auto space-y-10">
    <div class="max-w-2xl reveal">
      <h2 class="type-display" style="color: var(--text);" data-i18n="education.title">Education & certifications</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 reveal">
      {education.map((edu) => (
        <div class="flat-card">
          <div class="flex items-start justify-between gap-4">
            <div class="space-y-1">
              <h3 class="font-semibold" style="color: var(--text);">{edu.school}</h3>
              <p class="text-sm font-medium" style="color: var(--text-muted);">{edu.degree}</p>
              <p class="type-small">{edu.major}</p>
            </div>
            <span class="pill text-xs">{edu.range}</span>
          </div>
          {edu.notes && (
            <div class="mt-3 pt-3" style="border-top: 1px solid var(--border);">
              <span class="pill text-xs text-green-600 dark:text-green-400"><i class="ph ph-check-circle"></i> {edu.notes}</span>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
