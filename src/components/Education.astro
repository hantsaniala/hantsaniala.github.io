---
import education from '../data/education.json';
---

<section id="education" class="py-24 lg:py-32" data-animate>
  <div class="space-y-12">
    <div class="max-w-2xl">
      <span class="eyebrow mb-4 inline-flex">Education</span>
      <h2 class="text-display-lg" style="color: var(--text-primary);">
        Education & Certifications
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {education.map((edu) => (
        <div class="card-outer">
          <div class="card-inner">
            <div class="flex items-start justify-between gap-4">
              <div class="space-y-2">
                <h3 class="text-lg font-semibold" style="color: var(--text-primary);">{edu.school}</h3>
                <p class="text-primary font-medium text-sm">{edu.degree}</p>
                <p class="text-sm" style="color: var(--text-secondary);">{edu.major}</p>
              </div>
              <span class="text-xs font-mono px-3 py-1 rounded-full whitespace-nowrap self-start" style="background: var(--pill-bg); color: var(--text-muted);">
                {edu.range}
              </span>
            </div>
            {edu.notes && (
              <div class="mt-4 pt-4" style="border-top: 1px solid var(--card-border);">
                <span class="inline-flex items-center gap-2 text-xs font-medium text-emerald-400">
                  <i class="ph ph-check-circle"></i>
                  {edu.notes}
                </span>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
