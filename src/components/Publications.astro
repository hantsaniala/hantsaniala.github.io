---
const publications = [
  { title: 'Organic DevOps', description: 'A collection of articles, presentations or talks on Culture and DevOps.', date: '2020', url: '#' },
];
---

<section id="publications" class="py-24 lg:py-32" data-animate>
  <div class="space-y-10">
    <div class="max-w-2xl">
      <span class="eyebrow mb-4 inline-flex">Publications</span>
      <h2 class="text-display-lg" style="color: var(--text-primary);">
        Articles & Talks
      </h2>
      <p class="mt-4 text-[0.95rem] leading-relaxed" style="color: var(--text-secondary);">
        A collection of articles, presentations or talks, most likely on Culture and DevOps,
        because let's admit it, they are one and the same.
      </p>
    </div>

    <div class="space-y-4 max-w-2xl">
      {publications.map((pub) => (
        <a href={pub.url} class="block group">
          <div class="card-outer">
            <div class="card-inner flex items-start justify-between gap-6">
              <div>
                <h4 class="font-semibold group-hover:text-primary transition-colors duration-300" style="color: var(--text-primary);">{pub.title}</h4>
                <p class="text-sm mt-2 leading-relaxed" style="color: var(--text-secondary);">{pub.description}</p>
              </div>
              <span class="text-xs font-mono px-3 py-1 rounded-full whitespace-nowrap" style="background: var(--pill-bg); color: var(--text-muted);">{pub.date}</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
