---
import { site } from '../data/site';
---

<section id="hero" class="min-h-[80dvh] flex items-center relative overflow-hidden">
  <!-- Unsplash background with parallax -->
  <div class="parallax-container absolute inset-0">
    <div class="parallax-bg" style="background-image: url('https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=1920&q=80'); opacity: 0.08;"></div>
  </div>

  <div class="relative z-10 w-full max-w-6xl mx-auto px-6 py-16 lg:py-20">
    <div class="space-y-5">
      <!-- Eyebrow pill -->
      <span class="pill">
        <span class="w-2 h-2 rounded-full bg-green-500"></span>
        Available for hire
      </span>

      <!-- Big headline -->
      <h1 class="type-hero" style="color: var(--text);">
        Ship Reliable<br />Backends
      </h1>

      <!-- Subtext -->
      <p class="type-body text-lg max-w-xl">
        <strong>{site.firstName} {site.lastName}</strong>, freelance Go & Python developer building APIs, microservices, and cloud infrastructure.
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap items-center gap-4 pt-4">
        <a href={site.whatsapp} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          Let's discuss
          <i class="ph ph-arrow-up-right"></i>
        </a>
        <a href="/resume.pdf" download class="btn btn-outline">
          <i class="ph ph-download-simple"></i>
          Download Resume
        </a>
      </div>

      <!-- Stats pills -->
      <div class="flex flex-wrap gap-3 pt-4">
        <span class="pill">10+ years experience</span>
        <span class="pill">Go & Python</span>
        <span class="pill">Remote-first</span>
      </div>
    </div>
  </div>
</section>
