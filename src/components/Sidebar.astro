---
import { site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

const navIcons: Record<string, string> = {
  About: 'ph-user',
  Skills: 'ph-lightbulb',
  Experience: 'ph-briefcase',
  Education: 'ph-graduation-cap',
  Blog: 'ph-article',
};
---

<!-- Desktop icon rail -->
<aside
  class="hidden lg:flex fixed inset-y-0 left-0 w-[60px] flex-col items-center z-40 transition-colors duration-500"
  style="background: var(--sidebar-bg); border-right: 1px solid var(--sidebar-border); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);"
>
  <!-- Profile avatar -->
  <div class="pt-5 pb-4">
    <a href="/" class="block relative group" aria-label="Home">
      <div class="w-9 h-9 rounded-full overflow-hidden transition-all duration-500 group-hover:ring-2 group-hover:ring-primary/40"
           style="border: 1.5px solid var(--border-color);">
        <img src={site.profileImage} alt={site.firstName} class="w-full h-full object-cover" loading="eager" />
      </div>
      <div class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 bg-emerald-500 rounded-full"
           style="border: 1.5px solid var(--sidebar-bg);"></div>
    </a>
  </div>

  <div class="w-5 h-px mb-3" style="background: var(--card-border);"></div>

  <!-- Nav icons -->
  <nav class="flex-1 flex flex-col items-center gap-1">
    {site.navItems.map((item) => {
      const icon = navIcons[item.label] ?? 'ph-circle';
      return (
        <a href={item.href} class="sidebar-icon-link relative flex items-center justify-center w-9 h-9 rounded-xl transition-all duration-300 group" aria-label={item.label}>
          <i class={`ph ${icon} text-lg`}></i>
          <span class="sidebar-tooltip pointer-events-none absolute left-full ml-3 px-3 py-1.5 rounded-xl text-xs font-medium whitespace-nowrap opacity-0 group-hover:opacity-100 transition-all duration-200 z-50"
                style="background: var(--card-bg); color: var(--text-primary); border: 1px solid var(--card-border); backdrop-filter: blur(12px); box-shadow: 0 8px 24px rgba(0,0,0,0.3);">
            {item.label}
          </span>
        </a>
      );
    })}
  </nav>

  <!-- Bottom actions -->
  <div class="flex flex-col items-center gap-1 pb-5">
    <div class="relative group">
      <ThemeToggle />
      <span class="sidebar-tooltip pointer-events-none absolute left-full ml-3 px-3 py-1.5 rounded-xl text-xs font-medium whitespace-nowrap opacity-0 group-hover:opacity-100 transition-all duration-200 z-50"
            style="background: var(--card-bg); color: var(--text-primary); border: 1px solid var(--card-border); backdrop-filter: blur(12px); box-shadow: 0 8px 24px rgba(0,0,0,0.3);">
        Toggle theme
      </span>
    </div>

    <div class="w-5 h-px my-1" style="background: var(--card-border);"></div>

    {site.socials.slice(0, 4).map((social) => (
      <a href={social.url} target="_blank" rel="noopener noreferrer"
         class="sidebar-icon-link relative flex items-center justify-center w-9 h-9 rounded-xl transition-all duration-300 group"
         title={social.name} aria-label={social.name}>
        <i class={`ph ph-${social.icon} text-sm`}></i>
        <span class="sidebar-tooltip pointer-events-none absolute left-full ml-3 px-3 py-1.5 rounded-xl text-xs font-medium whitespace-nowrap opacity-0 group-hover:opacity-100 transition-all duration-200 z-50"
              style="background: var(--card-bg); color: var(--text-primary); border: 1px solid var(--card-border); backdrop-filter: blur(12px); box-shadow: 0 8px 24px rgba(0,0,0,0.3);">
          {social.name}
        </span>
      </a>
    ))}
  </div>
</aside>

<!-- Mobile header -->
<header
  class="lg:hidden fixed top-0 inset-x-0 h-14 z-40 flex items-center justify-between px-4 transition-colors duration-500"
  style="background: var(--sidebar-bg); border-bottom: 1px solid var(--sidebar-border); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);"
>
  <div class="flex items-center gap-2.5">
    <div class="w-8 h-8 rounded-full overflow-hidden" style="border: 1px solid var(--border-color);">
      <img src={site.profileImage} alt={site.firstName} class="w-full h-full object-cover" />
    </div>
    <span class="text-sm font-semibold" style="color: var(--text-primary);">
      {site.firstName} <span class="text-primary">{site.lastName}</span>
    </span>
  </div>

  <div class="flex items-center gap-1.5">
    <ThemeToggle />
    <button id="mobile-menu-toggle" class="p-2 rounded-xl transition-colors" style="color: var(--text-muted);" aria-label="Toggle navigation">
      <i class="ph ph-list text-lg"></i>
    </button>
  </div>
</header>

<!-- Mobile nav overlay -->
<div id="mobile-menu" class="lg:hidden fixed inset-0 z-50 hidden" style="background: rgba(5,5,5,0.95); backdrop-filter: blur(24px);">
  <div class="flex flex-col items-center justify-center h-full gap-6">
    <button id="mobile-menu-close" class="absolute top-4 right-4 p-2 rounded-xl transition-colors" style="color: var(--text-muted);" aria-label="Close navigation">
      <i class="ph ph-x text-lg"></i>
    </button>

    <div class="text-center mb-2">
      <div class="w-16 h-16 rounded-full overflow-hidden mx-auto mb-3" style="border: 2px solid var(--accent); opacity: 0.3;">
        <img src={site.profileImage} alt={site.firstName} class="w-full h-full object-cover" />
      </div>
      <h2 class="text-base font-semibold" style="color: var(--text-primary);">
        {site.firstName} <span class="text-primary">{site.lastName}</span>
      </h2>
      <p class="text-xs mt-0.5" style="color: var(--text-muted);">Freelance Developer</p>
    </div>

    <nav>
      <ul class="flex flex-col items-center gap-3">
        {site.navItems.map((item) => (
          <li>
            <a href={item.href} class="flex items-center gap-3 text-base font-medium mobile-nav-link transition-colors duration-300" style="color: var(--text-muted);">
              <i class={`ph ${navIcons[item.label] ?? 'ph-circle'} text-lg`}></i>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mt-4 flex items-center gap-3">
      {site.socials.map((social) => (
        <a href={social.url} target="_blank" rel="noopener noreferrer" class="w-8 h-8 flex items-center justify-center rounded-xl transition-all duration-300" style="color: var(--text-muted);" title={social.name} aria-label={social.name}>
          <i class={`ph ph-${social.icon} text-base`}></i>
        </a>
      ))}
    </div>
  </div>
</div>

<style>
  .sidebar-icon-link { color: var(--text-muted); }
  .sidebar-icon-link:hover { color: var(--accent); background: var(--pill-hover-bg); }
</style>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const close = document.getElementById('mobile-menu-close');
  const menu = document.getElementById('mobile-menu');
  const links = document.querySelectorAll('.mobile-nav-link');
  toggle?.addEventListener('click', () => menu?.classList.remove('hidden'));
  close?.addEventListener('click', () => menu?.classList.add('hidden'));
  links.forEach((link) => link.addEventListener('click', () => menu?.classList.add('hidden')));
</script>
