---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  ogDescription?: string;
  twitterDescription?: string;
  image?: string;
  type?: string;
  noindex?: boolean;
}

const {
  title = site.title,
  description = site.description,
  ogDescription = description,
  twitterDescription = ogDescription,
  image = site.profileImage,
  type = 'website',
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, site.url);
const imageURL = new URL(image, site.url).href;

const personSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.author,
  url: site.url,
  jobTitle: 'Freelance Software Developer',
  email: site.email,
  sameAs: site.socials.map((s) => s.url),
});
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />

  <!-- Robots -->
  {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow" />}

  <!-- Primary Meta -->
  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />
  <meta name="author" content={site.author} />

  <!-- Canonical -->
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonicalURL.href} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={ogDescription} />
  <meta property="og:image" content={imageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content={site.author} />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@hantsaniala" />
  <meta name="twitter:creator" content="@hantsaniala" />
  <meta name="twitter:url" content={canonicalURL.href} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={twitterDescription} />
  <meta name="twitter:image" content={imageURL} />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/assets/logo.png" />
  <link rel="apple-touch-icon" href="/assets/logo.png" />

  <!-- Preconnect for faster resource loading -->
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />

  <!-- Phosphor Icons -->
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/regular/style.css"
  />
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/bold/style.css"
  />

  <!-- Structured Data -->
  <script type="application/ld+json" set:html={personSchema} />

  <!-- Prevent theme flash -->
  <script is:inline>
    (function() {
      var t = localStorage.getItem('theme');
      if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      if (t === 'dark') document.documentElement.classList.add('dark');
    })();
  </script>

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-86V76P5643"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-86V76P5643');
  </script>
</head>
