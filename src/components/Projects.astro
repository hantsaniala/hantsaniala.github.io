---
const creations = [
  { title: 'dj', description: 'Django + uv helper CLI for streamlined Django project management.', tags: ['Go', 'Docker', 'Django'], url: 'https://github.com/hantsaniala/dj', stars: null },
  { title: 'trosa', description: 'A Flutter app to manage loan lists, built with Dart.', tags: ['Dart', 'Flutter'], url: 'https://github.com/hantsaniala/trosa', stars: 7 },
  { title: 'backlog', description: 'Project backlog management tool.', tags: ['Go'], url: 'https://github.com/hantsaniala/backlog', stars: null },
  { title: 'lazybacklog.nvim', description: 'LazyVim plugin for Backlog, manage projects from Neovim.', tags: ['Lua', 'Neovim'], url: 'https://github.com/hantsaniala/lazybacklog.nvim', stars: 1 },
  { title: 'hStream', description: 'A simple HLS VOD server made with Go. Stream video on demand with Docker.', tags: ['Go', 'Docker'], url: 'https://github.com/hantsaniala/hStream', stars: 6 },
  { title: 'uploader', description: 'File uploader across multiple FTP servers, built with Go.', tags: ['Go', 'FTP'], url: 'https://github.com/hantsaniala/uploader', stars: 8 },
];

const contributions = [
  { title: 'is-a.dev', description: "Grab your own sweet-looking '.is-a.dev' subdomain.", tags: ['JavaScript'], url: 'https://github.com/hantsaniala/is-a.dev' },
  { title: 'chit', description: 'Go Chi template generator.', tags: ['Go'], url: 'https://github.com/hantsaniala/chit' },
  { title: 'go-ftp', description: 'A Go client for performing common FTP operations.', tags: ['Go'], url: 'https://github.com/hantsaniala/go-ftp' },
  { title: 'webtoon-dl', description: 'A webtoon comic downloader for the command line.', tags: ['Go'], url: 'https://github.com/hantsaniala/webtoon-dl' },
];
---

<section id="projects" class="section">
  <div class="max-w-6xl mx-auto space-y-12">
    <div class="max-w-2xl reveal">
      <h2 class="type-display" style="color: var(--text);">Projects & contributions</h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
      <div class="space-y-4 reveal">
        <h3 class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider" style="color: var(--text-muted);">
          <i class="ph ph-plus-circle"></i> Creations
        </h3>
        <div class="space-y-3">
          {creations.map((project) => (
            <a href={project.url} target="_blank" rel="noopener noreferrer" class="block group">
              <div class="flat-card">
                <div class="flex items-start justify-between">
                  <h4 class="font-semibold group-hover:opacity-70 transition-opacity" style="color: var(--text);">{project.title}</h4>
                  <div class="flex items-center gap-2">
                    {project.stars && (
                      <span class="flex items-center gap-1 text-xs" style="color: var(--text-muted);">
                        <i class="ph-fill ph-star"></i>{project.stars}
                      </span>
                    )}
                    <i class="ph ph-arrow-up-right text-sm" style="color: var(--text-muted);"></i>
                  </div>
                </div>
                <p class="type-small mt-1">{project.description}</p>
                <div class="flex flex-wrap gap-1.5 mt-2">
                  {project.tags.map((tag) => (
                    <span class="pill text-xs">{tag}</span>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>

      <div class="space-y-4 reveal">
        <h3 class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider" style="color: var(--text-muted);">
          <i class="ph ph-git-fork"></i> Contributions
        </h3>
        <div class="space-y-3">
          {contributions.map((project) => (
            <a href={project.url} target="_blank" rel="noopener noreferrer" class="block group">
              <div class="flat-card">
                <div class="flex items-start justify-between">
                  <h4 class="font-semibold group-hover:opacity-70 transition-opacity" style="color: var(--text);">{project.title}</h4>
                  <i class="ph ph-arrow-up-right text-sm" style="color: var(--text-muted);"></i>
                </div>
                <p class="type-small mt-1">{project.description}</p>
                <div class="flex flex-wrap gap-1.5 mt-2">
                  {project.tags.map((tag) => (
                    <span class="pill text-xs">{tag}</span>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
