---
const benefits = [
  { skill: 'Go (Gin)', benefit: 'Ship fast, type-safe APIs that handle high concurrency with minimal memory footprint', icon: 'ph-diamonds-four' },
  { skill: 'Python (Django)', benefit: 'Rapidly build secure, maintainable backends with built-in admin, ORM, and auth', icon: 'ph-code' },
  { skill: 'REST & GraphQL APIs', benefit: 'Design clean, documented APIs that frontend and mobile teams enjoy consuming', icon: 'ph-plugs' },
  { skill: 'Microservices', benefit: 'Decouple monoliths into independently deployable services that scale per-component', icon: 'ph-squares-four' },
  { skill: 'Docker & AWS', benefit: 'Containerise and deploy with repeatable, infrastructure-as-code pipelines', icon: 'ph-cloud' },
  { skill: 'PostgreSQL & GORM', benefit: 'Design performant schemas and queries that stay fast as your data grows', icon: 'ph-database' },
  { skill: 'Neovim & OpenCode', benefit: 'Terminal-speed workflows with keyboard-driven editing and AI-assisted coding', icon: 'ph-terminal' },
  { skill: 'DevOps & CI/CD', benefit: 'Automate testing, building, and deployment so you ship with confidence', icon: 'ph-arrows-clockwise' },
];
---

<section id="skills" class="section">
  <div class="max-w-6xl mx-auto space-y-12">
    <div class="max-w-2xl reveal">
      <span class="pill mb-6">Technical Expertise</span>
      <h2 class="type-display" style="color: var(--text);">What you get</h2>
      <p class="type-body mt-4">Every skill maps to a concrete outcome for your project.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 reveal">
      {benefits.map((item, i) => (
        <div class={`flat-card ${i === 0 || i === 3 ? 'md:col-span-2' : ''}`}>
          <div class="flex items-center gap-3 mb-3">
            <span class="pill"><i class={`ph ${item.icon}`}></i></span>
            <h3 class="font-semibold text-sm" style="color: var(--text);">{item.skill}</h3>
          </div>
          <p class="type-small">{item.benefit}</p>
        </div>
      ))}
    </div>
  </div>
</section>
